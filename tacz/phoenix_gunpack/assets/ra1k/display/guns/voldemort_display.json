{
    // 默认的模型，在包目录下的 models 文件夹中寻找，不可为空
    "model": "ra1k:gun/voldemort_geo",
    // 默认材质，不可为空
    "texture": "ra1k:gun/uv/voldemort",
    // 低模    
    // GUI/HUD 界面的 2D 材质，在包目录下的 textures 文件夹中寻找，可为空，若为空，则对应位置不会渲染
    "hud": "ra1k:gun/hud/voldemort",
	"lod": {
    "model": "ra1k:gun/lod/voldemort",
    "texture": "ra1k:gun/uv/voldemort"
  },
    // 背包/快捷栏等容器中槽位显示的 2D 材质，在包目录下的 textures 文件夹中寻找，不建议为空
    "slot": "ra1k:gun/slot/voldemort",
    // 调用的动画名，会在包目录下的 animations 文件夹中寻找，不建议为空
    "animation": "ra1k:voldemort",
    // 指定使用缺省动画，可为空。如果上文指定的动画文件里缺少某个动画，如 draw 动画，则会从缺省动画拷贝。
    // 值可为 rifle、pistol
    "use_default_animation": "rifle",
	"state_machine": "ra1k:voldemort_state_machine",
	 "third_person_animation": "default",
    // 第三人称动画，硬编码，只能选择已有类型，默认只有 default
    "player_animator_3rd": "ra1k:voldemort.player_animation",
	"damage_style": "total",
    // 调整各个视角下模型的变换参数，可为空
    "transform": {
        // 暂时只有缩放需要在这里指定，旋转和位移使用模型内定位组。
        // 可以为空，若为空，则不缩放模型。
        "scale": {
            "thirdperson": [0.5, 0.5, 0.5],
            "ground": [0.45, 0.45, 0.45],
            "fixed": [1, 1, 1]
        }
    },
	"ammo": {
    "tracer_color": "#05FF00",
	 "particle": {
          // 名称，具体可选粒子可参考 wiki：https://minecraft.fandom.com/zh/wiki/%E7%B2%92%E5%AD%90
          "name": "happy_villager",
          // 生成的区域，默认为 0 0 0
          "delta": [
            0,
            0,
            0
          ],
          // 速度，默认为0，必须至少为 0
          "speed": 0,
          // 粒子存在时间，单位 tick，默认为 20 tick
          "life_time": 5,
          // 粒子数量，当子弹速度过快时，可以增大此数量，能够填满子弹路径的空隙
          "count": 20
    }	
  },
    "muzzle_flash": {
      "texture": "ra1k:flash/avada_flash",
      "scale": 0
    },
    // 抛壳的渲染数据，可为空，若为空，则枪械不抛壳
    "shell": {
        // 抛壳的初速度
        "initial_velocity": [8.0, 5.0, -0.5],
        // 抛壳随机变化的运动速度
        "random_velocity": [2.5, 1.5, 0.25],
        // 抛壳的加速度
        "acceleration": [0.0, -20, 0.0],
        // 抛壳的三轴角速度
        "angular_velocity": [720, 720, 90],
        // 抛壳渲染存活时间，单位为秒
        "living_time": 1.0
    },
    // 枪械音效，在包目录下 sounds 文件夹内寻找，不建议为空
    "sounds": {
    "draw": "tacz:m870/m870_draw",
    "shoot": "ra1k:voldemort/avada_kedavra",
    "shoot_3p": "ra1k:voldemort/avada_kedavra_mono3p",
	"silence": "tacz:ai_awp/awp_silence",
    "silence_3p": "tacz:ai_awp/awp_silence_3p",
    "put_away": "tacz:m870/m870_put_away",
    "melee_push": "tacz:melee_stock/melee_stock_02",
    "melee_stock": "tacz:melee_stock/melee_stock_03"
  }
}